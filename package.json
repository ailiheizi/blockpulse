{
  "name": "blockpulse-playground",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build:local": "node scripts/build-theme.mjs && node scripts/build-local.mjs",
    "build:pages": "node scripts/build-theme.mjs && node scripts/build-local.mjs --pages",
    "test": "node --test tests/*.test.mjs",
    "build:theme": "node scripts/build-theme.mjs",
    "build:contract": "node scripts/build-contract.mjs",
    "test:contracts": "cd contracts && forge test"
  }
}
